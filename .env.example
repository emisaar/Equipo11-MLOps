# ============================================================================
# Configuración de la API FastAPI - Tetouan Power Consumption
# ============================================================================

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS (Orígenes permitidos, separados por comas)
ALLOWED_ORIGINS=*

# ============================================================================
# MLFlow Configuration
# ============================================================================
# URI del servidor MLFlow (dentro de Docker o localhost)
MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_TRACKING_URI=http://localhost:5000  # Para desarrollo sin Docker

# Habilitar/deshabilitar MLFlow (true/false)
USE_MLFLOW=true

# ============================================================================
# AWS Configuration (para acceso a S3)
# ============================================================================
# Credenciales AWS para acceder a modelos en S3 vía MLFlow
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_DEFAULT_REGION=us-east-2

# ============================================================================
# Deployment
# ============================================================================
WORKERS=4
RELOAD=false

# Docker environment
DOCKER_ENV=development
# DOCKER_ENV=production