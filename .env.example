# ============================================================================
# Configuración de la API FastAPI - Tetouan Power Consumption
# ============================================================================

# ============================================================================
# API Server
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS (Orígenes permitidos, separados por comas)
ALLOWED_ORIGINS=*

# ============================================================================
# MLFlow Configuration
# ============================================================================
# URI del servidor MLFlow
# - Para DVC pipeline (ejecuta desde host, conecta a MLFlow en Docker): use http://localhost:5001
# - Para API en Docker (conecta a MLFlow en misma red Docker): use http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5001
# MLFLOW_TRACKING_URI=http://mlflow:5000  # Para API dentro de Docker

# Puerto donde MLFlow está expuesto en el host (mapeado desde container)
MLFLOW_PORT=5001

# Artefactos locales persistidos en disco
MLFLOW_ARTIFACT_ROOT=file:///mlflow/artifacts
MLFLOW_LOCAL_ARTIFACT_DIR=mlruns

# Experiment name
MLFLOW_EXPERIMENT_NAME=TetouanCityPower

# Run name prefix
MLFLOW_RUN_NAME=ModelEvaluation

# ============================================================================
# AWS S3 Configuration (para MLFlow artifacts y DVC remote storage)
# ============================================================================
# IMPORTANTE: Configurar estas variables para que MLFlow y DVC puedan
# acceder a los modelos y datos almacenados en S3

# AWS Access Keys (obtener desde AWS IAM)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS Region donde está el bucket S3
AWS_DEFAULT_REGION=us-east-2

# Bucket S3 para artefactos de MLFlow y DVC
# Formato: nombre-bucket o nombre-bucket/prefijo
AWS_S3_BUCKET=itesm-mna/202502-equipo11

# Drift Monitoring Configuration
# ============================================================================
# Intervalo de chequeo automático de drift (en horas)
DRIFT_CHECK_INTERVAL_HOURS=6

# Ventana de datos para monitoreo de drift (en horas)
DRIFT_MONITORING_WINDOW_HOURS=24

# Umbral de degradación de performance para alertas (0.0 - 1.0)
# 0.15 = 15% de degradación en métricas
DRIFT_PERFORMANCE_THRESHOLD=0.15

# ============================================================================
# Deployment
# ============================================================================
WORKERS=4
RELOAD=false

# Docker environment
DOCKER_ENV=development
# DOCKER_ENV=production

# ====================================================================
# Docker Hub (build/push)
# ====================================================================
DOCKER_REGISTRY=tu_usuario_dockerhub
# Username y password opcionales para login automático
DOCKER_USERNAME=tu_usuario_dockerhub
DOCKER_PASSWORD=tu_token_o_contraseña
