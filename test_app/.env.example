# Configuración de la API del Modelo
API_BASE_URL=http://localhost:8000

# Configuración de simulación
PREDICTION_INTERVAL=2
DRIFT_START_AFTER=50
DRIFT_INTENSITY=0.3

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=test_app.log

# Configuración de datos
SIMULATE_ZONES=1,2,3
TOTAL_PREDICTIONS=200

# Drift Configuration
# Tipos de drift disponibles: temperature, humidity, seasonal, all
DRIFT_TYPE=all
DRIFT_GRADUAL=true
